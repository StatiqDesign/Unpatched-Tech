{%- comment -%}
  One Gaming PC collection card with the NZXT-style Series selector INSIDE the
  card. Switching Series swaps the underlying Shopify product card in place,
  so image, title, price, description, swatches, links, and CTA all follow the
  selected build.
{%- endcomment -%}

{%- assign pc_collection = collections['prebuilt-gaming-pcs'] | default: collection -%}
{%- assign entry_pc = blank -%}
{%- assign mid_pc = blank -%}
{%- assign high_pc = blank -%}

{%- for pc_product in pc_collection.products -%}
  {%- case pc_product.handle -%}
    {%- when 'entry-tier-gaming-pc' -%}
      {%- assign entry_pc = pc_product -%}
    {%- when 'mid-tier-gaming-pc' -%}
      {%- assign mid_pc = pc_product -%}
    {%- when 'high-tier-gaming-pc' -%}
      {%- assign high_pc = pc_product -%}
  {%- endcase -%}
{%- endfor -%}

{%- assign initial_pc = entry_pc | default: mid_pc | default: high_pc | default: pc_collection.products.first -%}

{%- if initial_pc != blank -%}
  <div class="up-gaming-pc-series-card" data-up-gaming-pc-series-card>
    {%- if entry_pc != blank -%}
      <div class="up-gaming-pc-series-card__panel" data-up-pc-series-panel="{{ entry_pc.id }}" {% unless initial_pc.id == entry_pc.id %}hidden{% endunless %}>
        {%- render 'product-item', product: entry_pc, sizes_attribute: sizes_attribute, image_loading: image_loading, hide_secondary_image: true -%}
        {%- render 'unpatched-pc-series-selector', current_product: entry_pc, pc_collection: pc_collection -%}
      </div>
    {%- endif -%}

    {%- if mid_pc != blank -%}
      <div class="up-gaming-pc-series-card__panel" data-up-pc-series-panel="{{ mid_pc.id }}" {% unless initial_pc.id == mid_pc.id %}hidden{% endunless %}>
        {%- render 'product-item', product: mid_pc, sizes_attribute: sizes_attribute, image_loading: 'lazy', hide_secondary_image: true -%}
        {%- render 'unpatched-pc-series-selector', current_product: mid_pc, pc_collection: pc_collection -%}
      </div>
    {%- endif -%}

    {%- if high_pc != blank -%}
      <div class="up-gaming-pc-series-card__panel" data-up-pc-series-panel="{{ high_pc.id }}" {% unless initial_pc.id == high_pc.id %}hidden{% endunless %}>
        {%- render 'product-item', product: high_pc, sizes_attribute: sizes_attribute, image_loading: 'lazy', hide_secondary_image: true -%}
        {%- render 'unpatched-pc-series-selector', current_product: high_pc, pc_collection: pc_collection -%}
      </div>
    {%- endif -%}

    {%- for pc_product in pc_collection.products -%}
      {%- unless pc_product.handle == 'entry-tier-gaming-pc' or pc_product.handle == 'mid-tier-gaming-pc' or pc_product.handle == 'high-tier-gaming-pc' -%}
        <div class="up-gaming-pc-series-card__panel" data-up-pc-series-panel="{{ pc_product.id }}" {% unless initial_pc.id == pc_product.id %}hidden{% endunless %}>
          {%- render 'product-item', product: pc_product, sizes_attribute: sizes_attribute, image_loading: 'lazy', hide_secondary_image: true -%}
          {%- render 'unpatched-pc-series-selector', current_product: pc_product, pc_collection: pc_collection -%}
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>

  <style>
    .up-gaming-pc-series-card,
    .up-gaming-pc-series-card__panel,
    .up-gaming-pc-series-card__panel > product-item {
      width: 100%;
      min-width: 0;
    }

    .up-gaming-pc-series-card__panel[hidden] {
      display: none !important;
    }
  </style>

  <script>
    (function () {
      function mountSeriesSelectors(scope) {
        (scope || document).querySelectorAll('[data-up-gaming-pc-series-card]').forEach(function (root) {
          root.querySelectorAll('[data-up-pc-series-panel]').forEach(function (panel) {
            var selector = panel.querySelector('[data-up-pc-series-selector]');
            var title = panel.querySelector('.up-global-product-card__title');
            if (!selector || !title || selector.classList.contains('is-mounted')) return;

            title.insertAdjacentElement('afterend', selector);
            selector.classList.add('is-mounted');
          });
        });
      }

      mountSeriesSelectors(document);

      if (!window.__unpatchedGamingPcSeriesCardReady) {
        window.__unpatchedGamingPcSeriesCardReady = true;

        document.addEventListener('click', function (event) {
          var button = event.target.closest('[data-up-pc-series-target]');
          if (!button) return;

          var root = button.closest('[data-up-gaming-pc-series-card]');
          if (!root) return;

          event.preventDefault();
          event.stopPropagation();

          var target = button.getAttribute('data-up-pc-series-target');
          root.querySelectorAll('[data-up-pc-series-panel]').forEach(function (panel) {
            panel.hidden = panel.getAttribute('data-up-pc-series-panel') !== target;
          });

          mountSeriesSelectors(root);
        });

        document.addEventListener('shopify:section:load', function (event) {
          mountSeriesSelectors(event.target);
        });
      }
    })();
  </script>
{%- endif -%}
