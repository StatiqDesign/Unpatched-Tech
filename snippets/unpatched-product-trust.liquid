{%- assign is_gaming_pc = false -%}
{%- if product.template_suffix == 'computers' -%}
  {%- assign is_gaming_pc = true -%}
{%- endif -%}

<div class="unpatched-product-trust" aria-label="Product care">
  <div class="container">
    <div class="unpatched-product-trust__copy">
      {%- if is_gaming_pc -%}
        <h2 class="heading h3">Built with Love.</h2>
        <p>Every Unpatched Tech gaming PC is assembled, tested, and tuned with care before it reaches your setup.</p>
      {%- else -%}
        <h2 class="heading h3">Life Restored with Love.</h2>
        <p>Each refurbished system is carefully cleaned, tested, and restored so great hardware can keep playing for years to come.</p>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .unpatched-product-trust {
    padding: 34px 0 28px;
    border: 0;
    background: #fff;
  }

  .unpatched-product-trust__copy {
    max-width: 760px;
    margin: 0;
    text-align: left;
  }

  .unpatched-product-trust__copy .heading,
  .unpatched-product-trust__copy p {
    margin: 0;
  }

  .unpatched-product-trust__copy .heading {
    color: #25252a;
    font-size: clamp(25px, 2.2vw, 34px);
    line-height: 1.08;
    letter-spacing: -.025em;
  }

  .unpatched-product-trust__copy p {
    margin-top: 10px;
    max-width: 680px;
    color: rgba(37, 37, 42, .68);
    font-size: 15px;
    line-height: 1.65;
  }

  /* Restore the clean bordered disclosure rows without bringing the old shadow back. */
  body.unpatched-product-page #main .unpatched-product-disclosure-stack {
    display: grid !important;
    gap: 10px !important;
  }

  body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordions {
    border: 0 !important;
  }

  body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion,
  body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion[open] {
    border: 1px solid rgba(37, 37, 42, .11) !important;
    border-radius: var(--block-border-radius) !important;
    background: #fff !important;
    box-shadow: none !important;
  }

  body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion[open] {
    border-color: rgba(var(--unpatched-brand-blue-rgb), .28) !important;
  }

  body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion summary {
    padding-inline: 20px 18px !important;
  }

  body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion-content {
    padding-inline: 20px 58px !important;
  }

  @media screen and (max-width: 740px) {
    .unpatched-product-trust {
      padding: 24px 0 20px;
    }

    .unpatched-product-trust__copy .heading {
      font-size: 24px;
    }

    .unpatched-product-trust__copy p {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.6;
    }

    /* Give the sticky price / add-to-cart row a real phone gutter. */
    body.unpatched-product-page #main .unpatched-product-sticky__inner {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }

    body.unpatched-product-page #main .unpatched-product-sticky__price-wrap,
    body.unpatched-product-page #main .unpatched-product-sticky__price {
      margin-left: 0 !important;
    }

    /* Keep Product Details heading and body on the exact same left edge. */
    body.unpatched-product-page #main .shopify-section--product-content .product-tabs,
    body.unpatched-product-page #main .shopify-section--product-content .product-tabs__content,
    body.unpatched-product-page #main .shopify-section--product-content .product-tabs__tab-item-wrapper,
    body.unpatched-product-page #main .shopify-section--product-content .product-tabs__tab-item-content,
    body.unpatched-product-page #main .shopify-section--product-content collapsible-content,
    body.unpatched-product-page #main .shopify-section--product-content .collapsible {
      margin-left: 0 !important;
      padding-left: 0 !important;
    }

    body.unpatched-product-page #main .shopify-section--product-content .product-tabs {
      padding-left: 18px !important;
      padding-right: 18px !important;
    }

    body.unpatched-product-page #main .shopify-section--product-content .product-tabs::before,
    body.unpatched-product-page #main .shopify-section--product-content .product-tabs__tab-item-content,
    body.unpatched-product-page #main .shopify-section--product-content .product-tabs__tab-item-content p {
      margin-left: 0 !important;
      text-align: left !important;
    }

    body.unpatched-product-page #main .unpatched-product-disclosure-stack {
      gap: 8px !important;
    }

    body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion summary {
      padding-inline: 18px 16px !important;
    }

    body.unpatched-product-page #main .unpatched-product-disclosure-stack .unpatched-accordion-content {
      padding-inline: 18px 48px !important;
    }
  }
</style>

{%- render 'unpatched-product-reviews', product: product -%}
