{%- liquid
  assign pc_tier_config = 'entry-tier-gaming-pc|Entry Tier,mid-tier-gaming-pc|Mid Tier,high-tier-gaming-pc|High Tier' | split: ','
  assign pc_handles = 'entry-tier-gaming-pc,mid-tier-gaming-pc,high-tier-gaming-pc' | split: ','
-%}

{%- if pc_handles contains product.handle -%}
  <div class="up-system-selector" aria-label="Choose gaming PC system">
    <p class="up-system-selector__label">System:</p>

    <div class="up-system-selector__options" role="list">
      {%- for tier_config in pc_tier_config -%}
        {%- assign tier_parts = tier_config | split: '|' -%}
        {%- assign tier_handle = tier_parts[0] -%}
        {%- assign tier_label = tier_parts[1] -%}
        {%- assign tier_product = all_products[tier_handle] -%}

        {%- if tier_product != blank -%}
          <a
            href="{{ tier_product.url }}"
            class="up-system-selector__option{% if product.handle == tier_handle %} is-active{% endif %}"
            {% if product.handle == tier_handle %}aria-current="page"{% endif %}
            role="listitem"
          >
            {{ tier_label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
