<style>
  #shopify-section-{{ section.id }} {
    --progress-bar-color: {{ section.blocks.first.settings.text_color.red }}, {{ section.blocks.first.settings.text_color.green }}, {{ section.blocks.first.settings.text_color.blue }};
    --section-autoplay-duration: {% if section.settings.autoplay %}{{ section.settings.cycle_speed }}s{% else %}0s{% endif %};
    --section-animation-play-state: paused;
    background-color: {{ section.settings.background }}; /* Allows to set a placeholder color while loading */
  }

  {%- for block in section.blocks -%}
    {%- assign text_position = block.settings.text_position | split: '_' | first -%}

    {%- case text_position -%}
      {%- when 'top' -%}
        {%- assign section_items_alignment = 'flex-start' -%}
      {%- when 'middle' -%}
        {%- assign section_items_alignment = 'center' -%}
      {%- when 'bottom' -%}
        {%- assign section_items_alignment = 'flex-end' -%}
    {%- endcase -%}

    {%- liquid
      assign unpatched_image_justify = 'center'
      assign unpatched_image_align = 'center'
      case block.settings.image_position
        when 'center top'
          assign unpatched_image_align = 'flex-start'
        when 'center bottom'
          assign unpatched_image_align = 'flex-end'
        when 'left center'
          assign unpatched_image_justify = 'flex-start'
        when 'right center'
          assign unpatched_image_justify = 'flex-end'
      endcase
    -%}

    #block-{{ section.id }}-{{ block.id }} {
      --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --primary-button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
      --primary-button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};

      --section-blocks-alignment: {{ section_items_alignment }};
      --section-blocks-overlay-color: {{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }};
      --section-blocks-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      --unpatched-slide-image-scale: {{ block.settings.image_scale | default: 100 }}%;
      --unpatched-slide-image-fit: {{ block.settings.image_fit | default: 'cover' }};
      --unpatched-slide-image-position: {{ block.settings.image_position | default: 'center center' }};
      --unpatched-slide-image-background: {{ block.settings.image_background | default: section.settings.background }};
      --unpatched-slide-image-justify: {{ unpatched_image_justify }};
      --unpatched-slide-image-align: {{ unpatched_image_align }};
      --unpatched-slide-image-padding: {% if block.settings.image_fit == 'contain' %}3%{% else %}0{% endif %};
      --unpatched-content-backdrop: {{ block.settings.content_backdrop_color.red }}, {{ block.settings.content_backdrop_color.green }}, {{ block.settings.content_backdrop_color.blue }};
      --unpatched-content-backdrop-opacity: {{ block.settings.content_backdrop_opacity | divided_by: 100.0 }};
    }

    #block-{{ section.id }}-{{ block.id }} .slideshow__image-wrapper {
      box-sizing: border-box;
      display: flex;
      align-items: var(--unpatched-slide-image-align);
      justify-content: var(--unpatched-slide-image-justify);
      padding: var(--unpatched-slide-image-padding);
      background: var(--unpatched-slide-image-background);
    }

    #block-{{ section.id }}-{{ block.id }} .slideshow__image {
      width: var(--unpatched-slide-image-scale);
      height: var(--unpatched-slide-image-scale);
      max-width: none;
      object-fit: var(--unpatched-slide-image-fit);
      object-position: var(--unpatched-slide-image-position);
    }
  {%- endfor -%}

</style>

<section class="section section--flush">
  <slide-show {% if section.settings.show_initial_transition %}reveal-on-scroll{% endif %} {% if section.settings.autoplay %}auto-play{% endif %} transition-type="{{ section.settings.transition_type | escape }}" class="slideshow slideshow--{{ section.settings.section_height }}">
    <div id="slideshow-slides-{{ section.id }}" class="slideshow__slide-list">
      {%- for block in section.blocks -%}
        {%- comment -%}
        ------------------------------------------------------------------------------------------------------------------
        IMAGE PART
        ------------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- assign image = block.settings.image -%}
        {%- assign split_image = block.settings.split_image -%}
        {%- assign mobile_image = block.settings.mobile_image -%}
        {%- assign preload_attribute_value = false -%}
        {%- if forloop.first and mobile_image == blank -%}
          {%- assign preload_attribute_value = true -%}
        {%- endif -%}

        {%- assign image_aspect_ratio = image.aspect_ratio | default: 2.63 -%}

        {%- if image != blank and split_image != blank and section.settings.section_height == 'auto' -%}
          {%- assign image_aspect_ratio = image_aspect_ratio | times: 2.0 -%}
        {%- endif -%}

        {%- if forloop.first -%}
          {%- assign loading_attribute_value = 'eager' -%}
          {%- assign fetch_priority_value = 'high' -%}
        {%- else -%}
          {%- assign loading_attribute_value = 'lazy' -%}
          {%- assign fetch_priority_value = 'low' -%}
        {%- endif -%}

        {%- capture slide_content -%}
          <div class="slideshow__image-wrapper" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
            {%- if image != blank -%}
              {%- capture sizes_attributes -%}{% if split_image != blank %}(min-width: 1000px) 50vw{% else %}100vw{% endif %}{%- endcapture -%}
              {%- if mobile_image != blank -%}
                <picture>
                  <source
                    media="(max-width: 999px)"
                    sizes="100vw"
                    srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 800 }} 800w, {{ mobile_image | image_url: width: 1000 }} 1000w, {{ mobile_image | image_url: width: 1200 }} 1200w"
                    width="{{ mobile_image.width }}"
                    height="{{ mobile_image.height }}"
                  >
                  {{- image | image_url: width: 2400 | image_tag: loading: loading_attribute_value, fetchpriority: fetch_priority_value, preload: preload_attribute_value, draggable: false, class: 'slideshow__image', sizes: sizes_attributes, widths: '800,1200,1600,2000,2400' -}}
                </picture>
              {%- else -%}
                <picture>
                  <source
                    media="(max-width: 749px)"
                    sizes="calc(100vw - 24px)"
                    srcset="{{ image | image_url: width: 360 }} 360w, {{ image | image_url: width: 540 }} 540w, {{ image | image_url: width: 720 }} 720w, {{ image | image_url: width: 960 }} 960w, {{ image | image_url: width: 1200 }} 1200w"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                  {{- image | image_url: width: 2400 | image_tag: loading: loading_attribute_value, fetchpriority: fetch_priority_value, preload: preload_attribute_value, draggable: false, class: 'slideshow__image', sizes: sizes_attributes, widths: '800,1200,1600,2000,2400' -}}
                </picture>
              {%- endif -%}
            {%- else -%}
              {% capture image_name %}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
              {{- image_name | placeholder_svg_tag: 'slideshow__image slideshow__image--placeholder' -}}
            {%- endif -%}
          </div>

          {%- if image != blank and split_image != blank -%}
            <div class="slideshow__image-wrapper slideshow__image-wrapper--secondary hidden-pocket" {% if section.settings.transition_type == 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %}>
              {{- split_image | image_url: width: 1800 | image_tag: loading: loading_attribute_value, fetchpriority: fetch_priority_value, draggable: false, class: 'slideshow__image', sizes: '50vw', widths: '500,600,700,800,900,1000,1200,1400,1600,1800' -}}
            </div>
          {%- endif -%}

          {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          CONTENT PART
          ------------------------------------------------------------------------------------------------------------------
          {%- endcomment -%}

          {%- capture section_content -%}
            {%- if block.settings.subheading != blank -%}
              <p class="heading heading--small unpatched-eyebrow">
                <split-lines {% if section.settings.transition_type != 'fade' %}{% if section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}{% endif %}>{{ block.settings.subheading | escape }}</split-lines>
              </p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              {%- if forloop.first -%}
                <h1 class="heading heading--large">
                  <split-lines {% if section.settings.transition_type != 'fade' %}{% if section.settings.show_initial_transition %}reveal{% endif %}{% endif %}>{{ block.settings.title | escape }}</split-lines>
                </h1>
              {%- else -%}
                <h2 class="heading heading--large">
                  <split-lines {% if section.settings.transition_type != 'fade' %}reveal{% endif %}>{{ block.settings.title | escape }}</split-lines>
                </h2>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="unpatched-slideshow-copy rte" {% if section.settings.transition_type != 'fade' %}{% if section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}{% endif %}>
                {{- block.settings.content -}}
              </div>
            {%- endif -%}

            {%- capture buttons -%}
              {%- if block.settings.button_1_text != blank -%}
                <a href="{{ block.settings.button_1_link }}" class="button button--primary">{{ block.settings.button_1_text | escape }}</a>
              {%- endif -%}

              {%- if block.settings.button_2_text != blank -%}
                <a href="{{ block.settings.button_2_link }}" class="button button--primary">{{ block.settings.button_2_text | escape }}</a>
              {%- endif -%}
            {%- endcapture -%}

            {%- if block.settings.button_1_text != blank and block.settings.button_2_text != blank -%}
              <div class="button-group" {% if section.settings.transition_type != 'fade' %}{% if section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}{% endif %}>
                <div class="button-group__wrapper">
                  {{- buttons -}}
                </div>
              </div>
            {%- elsif buttons != blank -%}
              <div class="button-wrapper" {% if section.settings.transition_type != 'fade' %}{% if section.settings.show_initial_transition or forloop.first == false %}reveal{% endif %}{% endif %}>
                {{- buttons -}}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if section_content != blank -%}
            <div class="container">
              {%- assign text_alignment = block.settings.text_position | split: '_' | first -%}
              {%- assign text_position = block.settings.text_position | split: '_' | last -%}

              <div class="slideshow__text-wrapper slideshow__text-wrapper--{{ text_alignment }} vertical-breather">
                <div class="content-box content-box--medium content-box--text-{{ text_position }} content-box--{{ text_position }} text-container unpatched-slideshow-content-box">
                  {{- section_content -}}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- capture slide_attributes -%}
          {{ block.shopify_attributes }}
          id="block-{{ section.id }}-{{ block.id }}"
          class="slideshow__slide {% if split_image != blank %}slideshow__slide--split{% endif %} {% if section.settings.transition_type == 'sweep' %}slideshow__slide--sweep{% endif %}"
          {% unless forloop.first %}hidden{% endunless %}
          {% if section.settings.section_height == 'auto' %}
            style="--image-aspect-ratio: {{ image_aspect_ratio }}; --mobile-image-aspect-ratio: {{ mobile_image.aspect_ratio | default: image_aspect_ratio | default: 1 }};"
          {% endif %}
        {%- endcapture -%}

        <slide-show-item {% if section.settings.transition_type != 'reveal' and section.settings.show_initial_transition or forloop.first == false %}reveal-visibility{% endif %} {{ slide_attributes }}>
          {%- if block.settings.button_1_link != blank and block.settings.button_1_text == blank and block.settings.button_2_text == blank -%}
            <a class="slideshow__slide-inner" href="{{ block.settings.button_1_link }}">
              {{- slide_content -}}
            </a>
          {%- else -%}
            <div class="slideshow__slide-inner">
              {{- slide_content -}}
            </div>
          {%- endif -%}
        </slide-show-item>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="unpatched-slideshow-controls" aria-label="Slideshow controls">
        <button type="button" class="unpatched-slideshow-arrow unpatched-slideshow-arrow--previous" data-slideshow-direction="previous" aria-label="{{ 'general.accessibility.previous' | t }}">
          <img src="{{ 'arrow-left.svg' | asset_url }}" width="17" height="14" alt="" aria-hidden="true">
        </button>

        <button type="button" class="unpatched-slideshow-arrow unpatched-slideshow-arrow--next" data-slideshow-direction="next" aria-label="{{ 'general.accessibility.next' | t }}">
          <img src="{{ 'arrow-right.svg' | asset_url }}" width="17" height="14" alt="" aria-hidden="true">
        </button>
      </div>

      <page-dots {% if section.settings.autoplay %}animation-timer{% endif %} class="slideshow__nav container">
        {%- for block in section.blocks -%}
          <button class="slideshow__progress-bar" aria-controls="block-{{ section.id }}-{{ block.id }}" {% if forloop.first %}aria-current="true"{% endif%}>
            <span class="visually-hidden">{{ 'general.accessibility.go_to_slide' | t: num: forloop.index }}</span>
          </button>
        {%- endfor -%}
      </page-dots>
    {%- endif -%}
  </slide-show>
</section>
{% schema %}
{
  "name": "Slideshow",
  "class": "shopify-section--slideshow",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "auto", "label": "Original image ratio" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "fit", "label": "Fit screen height" }
      ],
      "info": "Choose \"Original image ratio\" to not cut images. [Learn more](https://help.shopify.com/en/manual/online-store/images/theme-images#best-practices-for-slideshows-and-full-width-images)",
      "default": "auto"
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "Transition type",
      "options": [
        { "value": "sweep", "label": "Sweep" },
        { "value": "reveal", "label": "Reveal" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "sweep"
    },
    {
      "type": "checkbox",
      "id": "show_initial_transition",
      "label": "Show initial transition",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate between slides",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Used while slideshow image is loading",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "info": "2160 x 1080px .jpg recommended, 1080 x 1080px .jpg recommended if split", "label": "Image" },
        { "type": "image_picker", "id": "split_image", "info": "1080 x 1080px .jpg recommended. Won't show up on mobile.", "label": "Split image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "1000 x 1400px .jpg recommended. If none is set, desktop image will be used." },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "options": [
            { "value": "cover", "label": "Cover" },
            { "value": "contain", "label": "Contain" }
          ],
          "default": "cover",
          "info": "Use Contain for product or logo imagery so it never gets blown up or cropped."
        },
        {
          "type": "range",
          "id": "image_scale",
          "label": "Image size",
          "min": 45,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 100
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ],
          "default": "center center"
        },
        { "type": "color", "id": "image_background", "label": "Image background", "default": "#f4f5f8" },
        { "type": "header", "content": "Content" },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "top_left", "label": "Top left" },
            { "value": "top_center", "label": "Top center" },
            { "value": "top_right", "label": "Top right" },
            { "value": "middle_left", "label": "Middle left" },
            { "value": "middle_center", "label": "Middle center" },
            { "value": "middle_right", "label": "Middle right" },
            { "value": "bottom_left", "label": "Bottom left" },
            { "value": "bottom_center", "label": "Bottom center" },
            { "value": "bottom_right", "label": "Bottom right" }
          ],
          "default": "middle_center"
        },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tell your story" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Slide title" },
        { "type": "richtext", "id": "content", "label": "Description" },
        { "type": "text", "id": "button_1_text", "label": "Button 1 text" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link", "info": "Leave the \"Button 1 text\" and \"Button 2\" settings empty to make the slide fully clickable." },
        { "type": "text", "id": "button_2_text", "label": "Button 2 text" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
        { "type": "header", "content": "Colors" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#25252a" },
        { "type": "color", "id": "content_backdrop_color", "label": "Text backdrop", "default": "#ffffff" },
        {
          "type": "range",
          "id": "content_backdrop_opacity",
          "label": "Text backdrop opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0,
          "info": "Adds a soft local backdrop behind the copy without washing out the whole image. Useful when a photo makes the text hard to read."
        },
        { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
        { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#000000" },
        { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#000000" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "category": "Banners",
      "blocks": [
        { "type": "image", "settings": { "title": "Slide 1" } },
        { "type": "image", "settings": { "title": "Slide 2" } }
      ]
    }
  ]
}
{% endschema %}