{%- if section.settings.enabled -%}
  <style>
    #shopify-section-{{ section.id }} .up-email-popup {
      position: fixed;
      inset: 0;
      z-index: 80;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(17, 17, 20, .48);
      backdrop-filter: blur(3px);
    }

    #shopify-section-{{ section.id }} .up-email-popup[hidden] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .up-email-popup__panel {
      position: relative;
      width: min(100%, 520px);
      padding: 34px;
      border: 1px solid rgba(37, 37, 42, .12);
      border-radius: 18px;
      background: #fff;
      color: #25252a;
      box-shadow: 0 24px 70px rgba(17, 17, 20, .18);
    }

    #shopify-section-{{ section.id }} .up-email-popup__close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border: 0;
      background: transparent;
      color: #25252a;
      font-size: 26px;
      line-height: 1;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .up-email-popup__title {
      margin: 0 42px 10px 0;
      color: #25252a;
      font-family: var(--heading-font-family);
      font-size: clamp(27px, 4vw, 38px);
      font-weight: var(--heading-font-weight);
      line-height: 1.05;
    }

    #shopify-section-{{ section.id }} .up-email-popup__copy {
      margin: 0 0 22px;
      color: rgba(37, 37, 42, .72);
      font-size: 15px;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .up-email-popup__form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .up-email-popup__input {
      width: 100%;
      min-height: 48px;
      padding: 0 14px;
      border: 1px solid rgba(37, 37, 42, .22);
      border-radius: 8px;
      background: #fff;
      color: #25252a;
    }

    #shopify-section-{{ section.id }} .up-email-popup__button {
      min-height: 48px;
      padding: 0 20px;
      border: 0;
      border-radius: 8px;
      background: #405DE6;
      color: #fff;
      font-family: var(--heading-font-family);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .05em;
      text-transform: uppercase;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .up-email-popup__message {
      grid-column: 1 / -1;
      margin: 2px 0 0;
      font-size: 13px;
      line-height: 1.45;
    }

    @media screen and (max-width: 540px) {
      #shopify-section-{{ section.id }} .up-email-popup {
        align-items: end;
        padding: 12px;
      }

      #shopify-section-{{ section.id }} .up-email-popup__panel {
        padding: 28px 20px 22px;
        border-radius: 16px;
      }

      #shopify-section-{{ section.id }} .up-email-popup__form {
        grid-template-columns: 1fr;
      }
    }
  </style>

  {%- form 'customer', id: 'up-email-popup-form', class: 'up-email-popup__customer-form' -%}
    <div
      id="UpEmailPopup-{{ section.id }}"
      class="up-email-popup"
      data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
      data-repeat-days="{{ section.settings.repeat_days }}"
      data-success="{% if form.posted_successfully? %}true{% else %}false{% endif %}"
      hidden
      aria-hidden="true"
    >
      <div class="up-email-popup__panel" role="dialog" aria-modal="true" aria-labelledby="UpEmailPopupTitle-{{ section.id }}">
        <button type="button" class="up-email-popup__close" data-up-email-close aria-label="Close email signup">×</button>

        <h2 id="UpEmailPopupTitle-{{ section.id }}" class="up-email-popup__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="up-email-popup__copy rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p class="up-email-popup__message">{{ section.settings.success_text | escape }}</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="up-email-popup__form">
            <input
              class="up-email-popup__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="{{ section.settings.email_placeholder | escape }}"
              aria-label="{{ section.settings.email_placeholder | escape }}"
            >
            <button class="up-email-popup__button" type="submit">{{ section.settings.button_text | escape }}</button>
            {%- if form.errors -%}
              <p class="up-email-popup__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endform -%}

  <script>
    (() => {
      const root = document.getElementById('UpEmailPopup-{{ section.id }}');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const storageKey = 'unpatched:email-popup-dismissed';
      const repeatDays = Number(root.dataset.repeatDays || 14);
      const delay = Number(root.dataset.delay || 5000);
      const success = root.dataset.success === 'true';
      let timer;

      const open = () => {
        root.hidden = false;
        root.setAttribute('aria-hidden', 'false');
      };

      const close = (remember = true) => {
        root.hidden = true;
        root.setAttribute('aria-hidden', 'true');
        if (remember) {
          try { localStorage.setItem(storageKey, String(Date.now())); } catch (e) {}
        }
      };

      const recentlyDismissed = () => {
        try {
          const value = Number(localStorage.getItem(storageKey) || 0);
          return value > 0 && (Date.now() - value) < repeatDays * 86400000;
        } catch (e) {
          return false;
        }
      };

      root.querySelector('[data-up-email-close]')?.addEventListener('click', () => close(true));
      root.addEventListener('click', (event) => {
        if (event.target === root) close(true);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !root.hidden) close(true);
      });

      if (Shopify.designMode) {
        document.addEventListener('shopify:section:select', (event) => {
          if (event.detail.sectionId === '{{ section.id }}') open();
        });
        document.addEventListener('shopify:section:deselect', (event) => {
          if (event.detail.sectionId === '{{ section.id }}') close(false);
        });
      }

      if (success) {
        open();
        try { localStorage.setItem(storageKey, String(Date.now())); } catch (e) {}
      } else if (!Shopify.designMode && !recentlyDismissed()) {
        timer = window.setTimeout(open, delay);
      }

      document.addEventListener('shopify:section:unload', (event) => {
        if (event.detail.sectionId === '{{ section.id }}' && timer) window.clearTimeout(timer);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Email Popup",
  "class": "shopify-section--email-popup",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable email popup",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get product drops, refurbished restocks, build updates, and useful tech news from Unpatched Tech.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email field placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Sign me up"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "You’re in. Thanks for signing up."
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Show after",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "range",
      "id": "repeat_days",
      "label": "Wait before showing again after dismissal",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Email Popup",
      "category": "Popups & Privacy"
    }
  ]
}
{% endschema %}
