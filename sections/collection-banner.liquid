<section class="unpatched-collection-hero-shell" style="--up-collection-ink: {{ section.settings.text_color }}; --up-collection-muted: {{ section.settings.muted_text_color }}; --up-collection-blue: {{ section.settings.accent_color }}; --up-collection-line: {{ section.settings.border_color }}; --up-collection-links-bg: {{ section.settings.links_background }}; --up-collection-links-text: {{ section.settings.links_text_color }};">
  <div class="unpatched-collection-hero unpatched-collection-hero--no-media">
    <div class="container unpatched-collection-hero__container">
      <div class="unpatched-collection-hero__layout unpatched-collection-hero__layout--no-media">
        <div class="unpatched-collection-hero__copy">
          {%- if section.settings.show_collection_title -%}
            <h1 class="heading h1 unpatched-collection-hero__title">{{ collection.title | escape }}</h1>
          {%- endif -%}

          {%- if section.settings.show_collection_description and collection.description != blank -%}
            <div class="unpatched-collection-hero__description rte">{{- collection.description -}}</div>
          {%- elsif section.settings.fallback_description != blank -%}
            <p class="unpatched-collection-hero__description unpatched-collection-hero__description--fallback">{{ section.settings.fallback_description | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- assign quick_links_menu = section.settings.quick_links -%}
  {%- if quick_links_menu.links.size > 0 -%}
    <div class="unpatched-collection-links">
      <div class="container unpatched-collection-links__inner">
        {%- if section.settings.quick_links_label != blank -%}
          <span class="unpatched-collection-links__label heading heading--small">{{ section.settings.quick_links_label | escape }}</span>
        {%- endif -%}
        <div class="unpatched-collection-links__scroller hide-scrollbar">
          <ul role="list">
            {%- for link in quick_links_menu.links -%}
              <li><a href="{{ link.url }}" class="unpatched-collection-link{% if link.active %} is-active{% endif %}">{{- link.title | escape -}}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection banner",
  "class": "shopify-section--collection-banner",
  "settings": [
    {"type": "paragraph", "content": "Collection titles and descriptions come from the collection in Shopify admin."},
    {"type": "checkbox", "id": "show_collection_title", "label": "Show collection title", "default": true},
    {"type": "checkbox", "id": "show_collection_description", "label": "Show collection description", "default": true},
    {"type": "textarea", "id": "fallback_description", "label": "Fallback description", "default": "Curated hardware, clear options, and no filler. Find the setup that fits and get back in the game."},
    {"type": "header", "content": "Navigation"},
    {"type": "link_list", "id": "quick_links", "label": "Quick links", "info": "Optional. Leave blank for the cleanest collection layout."},
    {"type": "text", "id": "quick_links_label", "label": "Quick links heading", "default": "EXPLORE"},
    {"type": "header", "content": "Colors"},
    {"type": "color", "id": "text_color", "label": "Heading text", "default": "#25252a"},
    {"type": "color", "id": "muted_text_color", "label": "Description text", "default": "#6f6f73"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#405de6"},
    {"type": "color", "id": "border_color", "label": "Borders", "default": "#e5e7eb"},
    {"type": "color", "id": "links_background", "label": "Quick links background", "default": "#ffffff"},
    {"type": "color", "id": "links_text_color", "label": "Quick links text", "default": "#25252a"}
  ]
}
{% endschema %}