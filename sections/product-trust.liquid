<section class="product-trust" aria-labelledby="product-trust-title-{{ section.id }}">
  <div class="container">
    <div class="product-trust__header">
      <h2 id="product-trust-title-{{ section.id }}" class="heading h3">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="product-trust__intro">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="product-trust__grid">
      <div class="product-trust__item">
        <span class="product-trust__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        </span>
        <div>
          <h3 class="product-trust__title">Checked Before Shipping</h3>
          <p class="product-trust__text">Every product is reviewed and prepared before it leaves us.</p>
        </div>
      </div>

      <div class="product-trust__item">
        <span class="product-trust__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14.5"/>
            <path d="M8 7h8M8 11h8M8 15h5"/>
          </svg>
        </span>
        <div>
          <h3 class="product-trust__title">Clear, Honest Details</h3>
          <p class="product-trust__text">Specifications, condition, configuration, and what’s included are stated up front.</p>
        </div>
      </div>

      <div class="product-trust__item">
        <span class="product-trust__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 3-6.7"/>
            <path d="M3 4v5h5"/>
          </svg>
        </span>
        <div>
          <h3 class="product-trust__title">30-Day Returns</h3>
          <p class="product-trust__text">Returns are accepted within 30 days under our return policy.</p>
        </div>
      </div>

      <div class="product-trust__item">
        <span class="product-trust__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 13v-2a8 8 0 0 1 16 0v2"/>
            <path d="M4 13a2 2 0 0 0 2 2h1v-4H6a2 2 0 0 0-2 2ZM20 13a2 2 0 0 1-2 2h-1v-4h1a2 2 0 0 1 2 2Z"/>
            <path d="M17 17c0 2-2 3-5 3"/>
          </svg>
        </span>
        <div>
          <h3 class="product-trust__title">Real Support</h3>
          <p class="product-trust__text">Questions before or after your purchase? Unpatched Tech is here to help.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .product-trust {
    background: #f7f7f7;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 44px 0;
  }

  #shopify-section-{{ section.id }} .product-trust__header {
    max-width: 680px;
    margin: 0 auto 30px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .product-trust__header .heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .product-trust__intro {
    margin: 10px 0 0;
    color: rgba(0, 0, 0, 0.68);
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .product-trust__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  #shopify-section-{{ section.id }} .product-trust__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 4px 24px;
  }

  #shopify-section-{{ section.id }} .product-trust__item + .product-trust__item {
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }

  #shopify-section-{{ section.id }} .product-trust__icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 50%;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .product-trust__icon svg {
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .product-trust__title {
    margin: 1px 0 5px;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .product-trust__text {
    margin: 0;
    color: rgba(0, 0, 0, 0.64);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .product-trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 0;
    }

    #shopify-section-{{ section.id }} .product-trust__item:nth-child(3) {
      border-left: 0;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .product-trust {
      padding: 34px 0;
    }

    #shopify-section-{{ section.id }} .product-trust__header {
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .product-trust__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .product-trust__item {
      padding: 18px 0;
    }

    #shopify-section-{{ section.id }} .product-trust__item:first-child {
      padding-top: 0;
    }

    #shopify-section-{{ section.id }} .product-trust__item:last-child {
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .product-trust__item + .product-trust__item {
      border-left: 0;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product trust",
  "tag": "section",
  "class": "shopify-section--product-trust",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop with confidence."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Every Unpatched Tech order is prepared with care, clearly described, and backed by support before and after it reaches you."
    }
  ],
  "presets": [
    {
      "name": "Product trust"
    }
  ]
}
{% endschema %}
