{% schema %}
{
  "name": "SS - Comparison table #29",
  "tag": "section",
  "class": "section-product-comparison",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Primary product"
    },
    {
      "type": "image_picker",
      "id": "primary_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "primary_title",
      "label": "Title",
      "default": "R-01"
    },
    {
      "type": "text",
      "id": "primary_badge",
      "label": "Badge text",
      "default": "Convenient"
    },
    {
      "type": "header",
      "content": "Competitor"
    },
    {
      "type": "image_picker",
      "id": "competitor_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "competitor_title",
      "label": "Title",
      "default": "Others"
    },
    {
      "type": "text",
      "id": "competitor_badge",
      "label": "Badge text",
      "default": "Tedious"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "text_alignment",
        "id": "content_align",
        "label": "Alignment",
        "default": "center"
    },
    {
        "type": "text_alignment",
        "id": "content_align_mobile",
        "label": "Alignment - mobile",
        "default": "center"
    },     
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "options": [
        { "value": "heading_first", "label": "Heading left, table right" },
        { "value": "table_first", "label": "Table left, heading right" },
        { "value": "heading_first_vertical", "label": "Heading top, table bottom" },
        { "value": "table_first_vertical", "label": "Table top, heading bottom" }
      ],
      "default": "heading_first"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between heading and table",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_width",
      "label": "Column width",
      "min": 100,
      "max": 200,
      "step": 5,
      "default": 140,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_radius",
      "label": "Primary column corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Row padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Product image width",
      "min": 40,
      "max": 120,
      "step": 5,
      "default": 70,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "checkbox",
      "id": "product_title_custom",
      "label": "Use custom font",
      "info": "Applies to the product titles and badges",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "product_title_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.product_title_custom }}"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Product title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "feature_custom",
      "label": "Use custom font",
      "info": "Applies to the feature labels and row text",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "feature_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.feature_custom }}"
    },
    {
      "type": "range",
      "id": "feature_font_size",
      "label": "Feature text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "feature_font_weight",
      "label": "Feature text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600",
      "visible_if": "{{ section.settings.feature_custom == false }}"
    },
    {
      "type": "header",
      "content": "Dividers"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show divider lines",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Divider thickness",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "checkbox",
      "id": "primary_column_use_gradient",
      "label": "Primary column background gradient",
      "default": false
    },
    {
      "type": "color",
      "id": "primary_column_color",
      "label": "Primary column background",
      "default": "#121212",
      "visible_if": "{{ section.settings.primary_column_use_gradient == false }}"
    },
    {
      "type": "color",
      "id": "primary_column_gradient_start",
      "label": "Primary column gradient (left)",
      "default": "#121212",
      "visible_if": "{{ section.settings.primary_column_use_gradient }}"
    },
    {
      "type": "color",
      "id": "primary_column_gradient_end",
      "label": "Primary column gradient (right)",
      "default": "#404040",
      "visible_if": "{{ section.settings.primary_column_use_gradient }}"
    },
    {
      "type": "color",
      "id": "primary_column_text_color",
      "label": "Primary column text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Feature text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "competitor_text_color",
      "label": "Competitor text",
      "default": "#3d3d3d"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Primary column icons",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Competitor column icons",
      "default": "#3d3d3d"
    },
    {
      "type": "select",
      "id": "cross_stroke_style",
      "label": "Competitor icon style",
      "options": [
        { "value": "white", "label": "White stroke" },
        { "value": "transparent", "label": "Transparent stroke (Cutout)" }
      ],
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "rgba(255, 255, 255, 0.15)"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "solid",
      "options": [
        { "label": "Solid", "value": "solid" },
        { "label": "Gradient", "value": "gradient" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.background_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradient",
      "default": "linear-gradient(180deg, #FFFFFF 0%, #F4F4F4 100%)",
      "visible_if": "{{ section.settings.background_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Section margin (outside)"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal_mobile",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides - mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding (inside)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides - mobile",
      "default": 1.5
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "page",
      "options": [
        {
          "label": "Page",
          "value": "page"
        },
        {
          "label": "Full",
          "value": "full"
        },
        {
          "label": "Custom",
          "value": "custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 800,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "label": "Content width",
      "default": 1200,      
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "lazy",
      "label": "Lazy load",
      "info": "Lazy load images for speed optimisation",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading text",
          "default": "Comparison table #29"
        },
        {
          "type": "checkbox",
          "id": "heading_custom",
          "label": "Use custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "heading_font",
          "label": "Font family",
          "default": "josefin_sans_n4",
          "visible_if": "{{ block.settings.heading_custom }}"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "p", "label": "Paragraph" }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "min": 24,
          "max": 80,
          "step": 2,
          "default": 48,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "mobile_font_size",
          "label": "Mobile font size",
          "min": 18,
          "max": 48,
          "step": 2,
          "default": 32,
          "unit": "px"
        },
        {
          "type": "checkbox",
          "id": "italic",
          "label": "Italic",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "use_gradient",
          "label": "Use gradient text",
          "default": true
        },
        {
          "type": "color",
          "id": "gradient_start",
          "label": "Gradient start (left)",
          "default": "#121212",
          "visible_if": "{{ block.settings.use_gradient }}"
        },
        {
          "type": "color",
          "id": "gradient_end",
          "label": "Gradient end (right)",
          "default": "#404040",
          "visible_if": "{{ block.settings.use_gradient }}"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#121212",
          "visible_if": "{{ block.settings.use_gradient == false }}"
        }
      ]
    },
    {
      "type": "subtitle",
      "name": "Subtitle",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Everything you need in one simple scoop."
        },
        {
          "type": "checkbox",
          "id": "subtitle_custom",
          "label": "Use custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "subtitle_font",
          "label": "Font family",
          "default": "josefin_sans_n4",
          "visible_if": "{{ block.settings.subtitle_custom }}"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "min": 14,
          "max": 28,
          "step": 1,
          "default": 18,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "options": [
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" }
          ],
          "default": "400",
          "visible_if": "{{ block.settings.subtitle_custom == false }}"
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Color",
          "default": "#121212"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "default": "non_outline",
          "options": [
            {
              "label": "Link",
              "value": "link"
            },
            {
              "label": "Non-outline",
              "value": "non_outline"
            },
            {
              "label": "Non-outline & arrow",
              "value": "non_outline_arrow"
            },
            {
              "label": "Outline",
              "value": "outline"
            },
            {
              "label": "Outline & arrow",
              "value": "outline_arrow"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "button_custom",
          "label": "Use custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "button_font",
          "label": "Font family",
          "default": "josefin_sans_n4",
          "visible_if": "{{ block.settings.button_custom }}"
        },
        {
          "type": "range",
          "id": "button_size",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "default": 14
        },
        {
          "type": "range",
          "id": "button_size_mobile",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "label": "Font size - mobile",
          "default": 14
        },
        {
          "type": "checkbox",
          "id": "button_advanced",
          "label": "Show advanced settings",
          "default": false
        },
        {
          "type": "range",
          "id": "button_height",
          "min": 50,
          "max": 200,
          "step": 10,
          "unit": "%",
          "label": "Line height",
          "default": 100,
          "visible_if": "{{ block.settings.button_advanced }}"
        },
        {
          "type": "range",
          "id": "button_padding_horizontal",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Padding horizontal",
          "default": 40,
          "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_advanced }}"
        },
        {
          "type": "range",
          "id": "button_padding_horizontal_mobile",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Padding horizontal - mobile",
          "default": 32,
          "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_advanced }}"
        },
        {
          "type": "range",
          "id": "button_padding_vertical",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Padding vertical",
          "default": 20,
          "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_advanced }}"
        },
        {
          "type": "range",
          "id": "button_padding_vertical_mobile",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Padding vertical - mobile",
          "default": 20,
          "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_advanced }}"
        },
        {
          "type": "range",
          "id": "button_radius",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Roundness",
          "default": 100,
          "visible_if": "{{ block.settings.button_style != 'link' }}"
        },
        {
          "type": "range",
          "id": "button_border_thickness",
          "min": 1,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Border thickness",
          "default": 1,
          "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'outline_arrow' }}"
        },
        {
          "type": "range",
          "id": "button_mt",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Margin top",
          "default": 16,
          "visible_if": "{{ block.settings.button_advanced }}"
        },
        {
          "type": "range",
          "id": "button_mt_mobile",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Margin top - mobile",
          "default": 16,
          "visible_if": "{{ block.settings.button_advanced }}"
        },
        {
          "type": "checkbox",
          "id": "button_custom_styling",
          "label": "Use custom styling",
          "default": true,
          "visible_if": "{{ block.settings.button_style != 'link' }}"
        },
        {
          "type": "checkbox",
          "id": "button_full_width_mobile",
          "label": "Full width on mobile",
          "default": false,
          "visible_if": "{{ block.settings.button_style != 'link' }}"
        },          
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "label": "Text",
          "id": "button_color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "label": "Text hover",
          "id": "button_hover_color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "label": "Background",
          "id": "button_bg_color",
          "default": "#2D2D2D",
          "visible_if": "{{ block.settings.button_style != 'link' }}"
        },
        {
          "type": "color",
          "label": "Background hover",
          "id": "button_bg_hover_color",
          "default": "#2D2D2D",
          "visible_if": "{{ block.settings.button_style != 'link' }}"
        },
        {
          "type": "color",
          "label": "Border",
          "id": "button_border_color",
          "default": "#1A1A1A",
          "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'outline_arrow' }}"
        },
        {
          "type": "color",
          "label": "Border hover",
          "id": "button_border_hover_color",
          "default": "#1A1A1A",
          "visible_if": "{{ block.settings.button_style == 'outline' or block.settings.button_style == 'outline_arrow' }}"
        },
        {
          "type": "color",
          "label": "Shadow",
          "id": "button_shadow_color",
          "default": "#000000",
          "visible_if": "{{ block.settings.button_style != 'link' and block.settings.button_custom_styling }}"
        }
      ]
    },
    {
      "type": "feature_row",
      "name": "Feature row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature name",
          "default": "Feature"
        },
        {
          "type": "checkbox",
          "id": "primary_has_feature",
          "label": "Primary product has feature",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "competitor_has_feature",
          "label": "Competitor has feature",
          "default": false
        }
      ]
    },
    {
      "type": "text_row",
      "name": "Text row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature name",
          "default": "Benefits in"
        },
        {
          "type": "text",
          "id": "primary_text",
          "label": "Primary product text",
          "default": "One Scoop"
        },
