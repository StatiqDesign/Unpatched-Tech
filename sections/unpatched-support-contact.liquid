<section
  class="unpatched-support-page unpatched-contact-form-section"
  style="--up-section-bg: {{ section.settings.background }}; --up-section-text: {{ section.settings.text_color }}; --up-section-muted: {{ section.settings.muted_text_color }}; --up-section-card: {{ section.settings.card_background }}; --up-section-border: {{ section.settings.border_color }};"
>
  <div class="unpatched-support-contact" id="{{ section.settings.anchor_id | default: 'SupportForm' | escape }}">
    <div class="container">
      <header class="unpatched-contact-form__hero">
        {%- if section.settings.eyebrow != blank -%}
          <p class="heading heading--small unpatched-support-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h1 class="heading h1">{{ section.settings.title | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="unpatched-contact-form__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </header>

      <div class="unpatched-support-form-card unpatched-contact-form__card">
        {%- form 'contact', class: 'unpatched-support-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="unpatched-support-form__success">
              <strong>{{ section.settings.success_title | escape }}</strong>
              <p>{{ section.settings.success_text | escape }}</p>
            </div>
          {%- endif -%}

          {{ form.errors | default_errors }}

          <div class="unpatched-support-field">
            <label for="SupportTopic-{{ section.id }}">{{ section.settings.topic_label | escape }} <span>*</span></label>
            <select id="SupportTopic-{{ section.id }}" name="contact[Support topic]" required>
              <option value="" disabled selected>{{ section.settings.topic_placeholder | escape }}</option>
              <option value="Order & Shipping">Order &amp; Shipping</option>
              <option value="Product Question">Product Question</option>
              <option value="Repair & Mail-In">Repair &amp; Mail-In</option>
              <option value="Warranty">Warranty</option>
              <option value="Return or Refund">Return or Refund</option>
              <option value="PC Build">PC Build</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="unpatched-support-form__row">
            <div class="unpatched-support-field">
              <label for="SupportName-{{ section.id }}">{{ section.settings.name_label | escape }} <span>*</span></label>
              <input id="SupportName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required placeholder="{{ section.settings.name_placeholder | escape }}">
            </div>
            <div class="unpatched-support-field">
              <label for="SupportEmail-{{ section.id }}">{{ section.settings.email_label | escape }} <span>*</span></label>
              <input id="SupportEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ section.settings.email_placeholder | escape }}">
            </div>
          </div>

          <div class="unpatched-support-form__row">
            <div class="unpatched-support-field">
              <label for="SupportPhone-{{ section.id }}">{{ section.settings.phone_label | escape }}</label>
              <input id="SupportPhone-{{ section.id }}" type="tel" name="contact[Phone]" autocomplete="tel" placeholder="{{ section.settings.phone_placeholder | escape }}">
            </div>
            <div class="unpatched-support-field">
              <label for="SupportOrder-{{ section.id }}">{{ section.settings.order_label | escape }}</label>
              <input id="SupportOrder-{{ section.id }}" type="text" name="contact[Order number]" placeholder="{{ section.settings.order_placeholder | escape }}">
            </div>
          </div>

          <div class="unpatched-support-field">
            <label for="SupportDevice-{{ section.id }}">{{ section.settings.device_label | escape }}</label>
            <input id="SupportDevice-{{ section.id }}" type="text" name="contact[Product or device]" placeholder="{{ section.settings.device_placeholder | escape }}">
          </div>

          <div class="unpatched-support-field">
            <label for="SupportMessage-{{ section.id }}">{{ section.settings.message_label | escape }} <span>*</span></label>
            <textarea id="SupportMessage-{{ section.id }}" name="contact[body]" rows="8" required placeholder="{{ section.settings.message_placeholder | escape }}"></textarea>
          </div>

          <div class="unpatched-support-form__footer">
            <button type="submit" class="button button--primary unpatched-support-button">
              {{ section.settings.submit_text | escape }}
            </button>
          </div>
        {%- endform -%}

        <div class="unpatched-contact-form__direct">
          {%- if section.settings.direct_text != blank -%}<span>{{ section.settings.direct_text | escape }}</span>{%- endif -%}
          {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>{%- endif -%}
          {%- if section.settings.phone != blank -%}<a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}">{{ section.settings.phone | escape }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Support Form",
  "class": "shopify-section--unpatched-support-contact",
  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor",
      "default": "SupportForm"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "UNPATCHED SUPPORT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOW CAN WE HELP?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Tell us what you need and give us the context. Order numbers, device details, and what you've already tried help us get to the useful part faster."
    },
    {
      "type": "text",
      "id": "topic_label",
      "label": "Topic label",
      "default": "WHAT CAN WE HELP WITH?"
    },
    {
      "type": "text",
      "id": "topic_placeholder",
      "label": "Topic placeholder",
      "default": "Choose a support topic"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "NAME"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "EMAIL"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "PHONE — OPTIONAL"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone placeholder",
      "default": "Your phone number"
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order label",
      "default": "ORDER NUMBER — OPTIONAL"
    },
    {
      "type": "text",
      "id": "order_placeholder",
      "label": "Order placeholder",
      "default": "#1001"
    },
    {
      "type": "text",
      "id": "device_label",
      "label": "Device label",
      "default": "PRODUCT / DEVICE — OPTIONAL"
    },
    {
      "type": "text",
      "id": "device_placeholder",
      "label": "Device placeholder",
      "default": "Example: PlayStation 5 Slim, Xbox Series X, custom PC"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "TELL US WHAT'S GOING ON"
    },
    {
      "type": "textarea",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us what happened, what you're seeing, what you've already tried, and what outcome you're looking for."
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit button text",
      "default": "SEND SUPPORT REQUEST"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success heading",
      "default": "WE GOT IT."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Your message is in. We'll use the details you sent to figure out the right next step."
    },
    {
      "type": "text",
      "id": "direct_text",
      "label": "Direct contact text",
      "default": "Prefer to contact us directly?"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "hello@unpatchedtech.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Support phone",
      "default": "(818) 253-4658"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#25252a"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#6f6f73"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card and input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e7eb"
    }
  ],
  "presets": [
    {
      "name": "Support Form",
      "category": "Pages"
    }
  ]
}
{% endschema %}