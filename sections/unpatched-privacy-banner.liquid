{%- if section.settings.enabled -%}
  <style>
    #shopify-section-{{ section.id }} .up-privacy-banner.cookie-bar {
      width: min(calc(100vw - 32px), 460px);
      padding: 20px;
      border: 1px solid rgba(37, 37, 42, .14);
      border-radius: 14px;
      background: #fff;
      color: #25252a;
      box-shadow: 0 18px 50px rgba(17, 17, 20, .16);
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__title {
      margin: 0 0 7px;
      color: #25252a;
      font-family: var(--heading-font-family);
      font-size: 15px;
      font-weight: var(--heading-font-weight);
      line-height: 1.25;
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__copy {
      color: rgba(37, 37, 42, .72);
      font-size: 13px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__copy p {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 15px;
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__button {
      min-height: 40px;
      padding: 0 15px;
      border-radius: 7px;
      font-family: var(--heading-font-family);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__button--accept {
      border: 1px solid #405DE6;
      background: #405DE6;
      color: #fff;
    }

    #shopify-section-{{ section.id }} .up-privacy-banner__button--decline {
      border: 1px solid rgba(37, 37, 42, .18);
      background: #fff;
      color: #25252a;
    }

    @media screen and (max-width: 540px) {
      #shopify-section-{{ section.id }} .up-privacy-banner.cookie-bar {
        left: 12px;
        right: 12px;
        bottom: 12px;
        width: auto;
        max-width: none;
      }

      #shopify-section-{{ section.id }} .up-privacy-banner__actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>

  <cookie-bar section="{{ section.id }}" hidden class="cookie-bar up-privacy-banner text--xsmall">
    {%- if section.settings.heading != blank -%}
      <p class="up-privacy-banner__title">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="up-privacy-banner__copy rte">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="up-privacy-banner__actions">
      <button type="button" class="up-privacy-banner__button up-privacy-banner__button--accept" data-action="accept-policy">{{ section.settings.accept_text | escape }}</button>
      <button type="button" class="up-privacy-banner__button up-privacy-banner__button--decline" data-action="decline-policy">{{ section.settings.decline_text | escape }}</button>
    </div>
  </cookie-bar>
{%- endif -%}

{% schema %}
{
  "name": "Privacy & Cookies",
  "class": "shopify-section--privacy-banner",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable privacy banner",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your privacy matters."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We use cookies to keep the store working, understand site usage, and improve your experience.</p>"
    },
    {
      "type": "text",
      "id": "accept_text",
      "label": "Accept button",
      "default": "Accept"
    },
    {
      "type": "text",
      "id": "decline_text",
      "label": "Decline button",
      "default": "Decline"
    }
  ],
  "presets": [
    {
      "name": "Privacy & Cookies",
      "category": "Popups & Privacy"
    }
  ]
}
{% endschema %}
