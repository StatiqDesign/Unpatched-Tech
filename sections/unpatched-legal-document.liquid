{%- liquid
  assign privacy_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign terms_url = shop.terms_of_service.url | default: '/policies/terms-of-service'
  assign refund_url = shop.refund_policy.url | default: '/policies/refund-policy'
  assign shipping_url = shop.shipping_policy.url | default: '/policies/shipping-policy'
  assign current_legal_url = canonical_url | downcase
  assign document_title = section.settings.custom_title
  assign document_content = section.settings.custom_content
  assign active_policy = blank
  if current_legal_url contains '/privacy-policy'
    assign active_policy = shop.privacy_policy
  elsif current_legal_url contains '/terms-of-service'
    assign active_policy = shop.terms_of_service
  elsif current_legal_url contains '/refund-policy'
    assign active_policy = shop.refund_policy
  elsif current_legal_url contains '/shipping-policy'
    assign active_policy = shop.shipping_policy
  endif
  if active_policy != blank
    assign document_title = active_policy.title
    assign document_content = active_policy.body
  elsif page != blank
    if document_title == blank
      assign document_title = page.title
    endif
    if document_content == blank
      assign document_content = page.content
    endif
  endif
-%}
<section class="unpatched-legal-page{% if section.settings.show_directory %} unpatched-legal-page--hub{% endif %}" style="--up-legal-hero-bg: {{ section.settings.hero_background }}; --up-legal-hero-text: {{ section.settings.hero_text_color }}; --up-legal-hero-muted: {{ section.settings.hero_muted_text_color }}; --up-legal-accent: {{ section.settings.accent_color }}; --up-legal-nav-bg: {{ section.settings.nav_background }}; --up-legal-nav-text: {{ section.settings.nav_text_color }}; --up-legal-main-bg: {{ section.settings.main_background }}; --up-legal-card-bg: {{ section.settings.card_background }}; --up-legal-card-text: {{ section.settings.card_text_color }}; --up-legal-border: {{ section.settings.border_color }};"><header class="unpatched-legal-hero"><div class="unpatched-legal-hero__grid" aria-hidden="true"></div><div class="unpatched-legal-hero__glow" aria-hidden="true"></div><div class="container unpatched-legal-hero__inner">{%- if section.settings.eyebrow != blank -%}<p class="heading heading--small unpatched-legal-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}{%- if document_title != blank -%}<h1 class="heading unpatched-legal-hero__title">{{ document_title | escape }}</h1>{%- endif -%}{%- if section.settings.intro != blank -%}<div class="unpatched-legal-hero__intro"><p>{{ section.settings.intro | escape }}</p></div>{%- endif -%}{%- assign signal_count = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'signal' -%}{%- assign signal_count = signal_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- if signal_count > 0 -%}<div class="unpatched-legal-hero__signal" aria-label="Policy principles">{%- for block in section.blocks -%}{%- if block.type == 'signal' -%}<span {{ block.shopify_attributes }}><i aria-hidden="true"></i>{{ block.settings.label | escape }}</span>{%- endif -%}{%- endfor -%}</div>{%- endif -%}</div></header>{%- if section.settings.show_navigation -%}<nav class="unpatched-legal-nav" aria-label="Store policies"><div class="container unpatched-legal-nav__inner"><a href="{{ privacy_url }}"{% if current_legal_url contains '/privacy-policy' %} aria-current="page"{% endif %}>{{ section.settings.privacy_label | escape }}</a><a href="{{ terms_url }}"{% if current_legal_url contains '/terms-of-service' %} aria-current="page"{% endif %}>{{ section.settings.terms_label | escape }}</a><a href="{{ refund_url }}"{% if current_legal_url contains '/refund-policy' %} aria-current="page"{% endif %}>{{ section.settings.refund_label | escape }}</a><a href="{{ shipping_url }}"{% if current_legal_url contains '/shipping-policy' %} aria-current="page"{% endif %}>{{ section.settings.shipping_label | escape }}</a>{%- if section.settings.contact_link != blank -%}<a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }}</a>{%- endif -%}</div></nav>{%- endif -%}<div class="unpatched-legal-main"><div class="container">{%- if section.settings.show_directory -%}<section class="unpatched-legal-directory"><header class="unpatched-legal-section-heading"><div>{%- if section.settings.directory_eyebrow != blank -%}<p class="heading heading--small unpatched-legal-eyebrow">{{ section.settings.directory_eyebrow | escape }}</p>{%- endif -%}{%- if section.settings.directory_title != blank -%}<h2 class="heading h2">{{ section.settings.directory_title | escape }}</h2>{%- endif -%}</div>{%- if section.settings.directory_text != blank -%}<p>{{ section.settings.directory_text | escape }}</p>{%- endif -%}</header><div class="unpatched-legal-directory__grid">{%- assign directory_index = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'directory' -%}{%- assign directory_index = directory_index | plus: 1 -%}<a class="unpatched-legal-directory__card" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}><span class="unpatched-legal-directory__number">0{{ directory_index }}</span><span><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.text | escape }}</small></span><i aria-hidden="true">→</i></a>{%- endif -%}{%- endfor -%}</div></section>{%- endif -%}<div class="unpatched-legal-layout"><article class="unpatched-legal-document"><div class="unpatched-legal-document__top"><div><span class="unpatched-legal-document__status"><i aria-hidden="true"></i>{{ section.settings.status_text | escape }}</span><p>{{ shop.name | escape }}</p></div></div><div class="unpatched-legal-document__body rte">{{ document_content }}</div></article><aside class="unpatched-legal-aside"><div class="unpatched-legal-aside__card"><p class="heading heading--small unpatched-legal-eyebrow">{{ section.settings.help_eyebrow | escape }}</p><h2 class="heading">{{ section.settings.help_title | escape }}</h2><p>{{ section.settings.help_text | escape }}</p><div class="unpatched-legal-aside__links">{%- if section.settings.phone != blank -%}<a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}"><span>CALL</span><strong>{{ section.settings.phone | escape }}</strong></a>{%- endif -%}{%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email | escape }}"><span>EMAIL</span><strong>{{ section.settings.email | escape }}</strong></a>{%- endif -%}</div>{%- if section.settings.support_link != blank -%}<a class="unpatched-legal-aside__support" href="{{ section.settings.support_link }}">{{ section.settings.support_text | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}</div></aside></div></div></div></section>
{% schema %}
{"name":"Legal document","class":"shopify-section--unpatched-legal-document","max_blocks":9,"disabled_on":{"templates":["password"],"groups":["header","custom.overlay"]},"settings":[{"type":"text","id":"custom_title","label":"Custom title","info":"Used on regular pages. Shopify policy pages use the official policy title automatically."},{"type":"richtext","id":"custom_content","label":"Custom content","info":"Used on regular pages. Shopify policy pages use the official policy content automatically."},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE FINE PRINT, CLEANED UP"},{"type":"textarea","id":"intro","label":"Intro","default":"The policy below is the official version. We keep the presentation clean, the expectations clear, and a real support route close by if something does not make sense."},{"type":"checkbox","id":"show_navigation","label":"Show policy navigation","default":true},{"type":"text","id":"privacy_label","label":"Privacy label","default":"Privacy"},{"type":"text","id":"terms_label","label":"Terms label","default":"Terms"},{"type":"text","id":"refund_label","label":"Refund label","default":"Refunds"},{"type":"text","id":"shipping_label","label":"Shipping label","default":"Shipping"},{"type":"text","id":"contact_label","label":"Contact label","default":"Contact"},{"type":"url","id":"contact_link","label":"Contact link"},{"type":"checkbox","id":"show_directory","label":"Show policy directory","default":false},{"type":"text","id":"directory_eyebrow","label":"Directory eyebrow","default":"START HERE"},{"type":"text","id":"directory_title","label":"Directory heading","default":"FIND THE POLICY YOU NEED."},{"type":"textarea","id":"directory_text","label":"Directory text","default":"Skip the scavenger hunt. These are the store policies customers usually need before or after an order."},{"type":"text","id":"status_text","label":"Document status text","default":"OFFICIAL STORE INFORMATION"},{"type":"text","id":"help_eyebrow","label":"Help eyebrow","default":"NEED A HUMAN?"},{"type":"text","id":"help_title","label":"Help heading","default":"ASK US."},{"type":"textarea","id":"help_text","label":"Help text","default":"A policy should answer the question, not create three more. If something is unclear, send us the context and we'll point you in the right direction."},{"type":"text","id":"phone","label":"Phone"},{"type":"text","id":"email","label":"Email"},{"type":"text","id":"support_text","label":"Support link text","default":"OPEN SUPPORT HUB"},{"type":"url","id":"support_link","label":"Support link"},{"type":"header","content":"Colors"},{"type":"color","id":"hero_background","label":"Hero background","default":"#e6efff"},{"type":"color","id":"hero_text_color","label":"Hero heading text","default":"#25252a"},{"type":"color","id":"hero_muted_text_color","label":"Hero secondary text","default":"#6f6f73"},{"type":"color","id":"accent_color","label":"Accent color","default":"#405de6"},{"type":"color","id":"nav_background","label":"Policy navigation background","default":"#ffffff"},{"type":"color","id":"nav_text_color","label":"Policy navigation text","default":"#25252a"},{"type":"color","id":"main_background","label":"Main page background","default":"#ffffff"},{"type":"color","id":"card_background","label":"Document and card background","default":"#ffffff"},{"type":"color","id":"card_text_color","label":"Document and card text","default":"#25252a"},{"type":"color","id":"border_color","label":"Card and navigation border","default":"#e5e7eb"}],"blocks":[{"type":"signal","name":"Signal","limit":3,"settings":[{"type":"text","id":"label","label":"Label","default":"CLEAR EXPECTATIONS"}]},{"type":"directory","name":"Directory card","limit":6,"settings":[{"type":"text","id":"title","label":"Heading","default":"PRIVACY"},{"type":"textarea","id":"text","label":"Text","default":"How information is collected, used, and protected."},{"type":"url","id":"link","label":"Link"}]}]}
{% endschema %}